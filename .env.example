# Supabase (toto.z-labs.kr)
# ⚠️ 신규 프로젝트를 만들지 말고, 기존 z-labs(로또 서비스) 프로젝트를 공유한다.
#    (무료 티어 프로젝트 수 제한 회피). 테이블은 wooz_toto_ 프리픽스로 격리 → src/lib/tables.js
# 브라우저 노출 가능 (anon key) — NEXT_PUBLIC_ 접두사 필수
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (크론/시드/스크래퍼) — 절대 클라이언트 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AdSense (기존 z-labs 슬롯 컨벤션 재사용)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-3270769447461406

# 관리자 이메일 (이 이메일로 로그인한 유저만 /admin 접근·데이터 갱신 가능)
ADMIN_EMAIL=you@example.com
